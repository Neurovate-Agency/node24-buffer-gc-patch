   V8::SetFlagsFromString("--no-freeze-flags-after-init");
 
+#if !defined(V8_COMPRESS_POINTERS) && V8_MAJOR_VERSION < 14
+  // Keep short-lived external backing stores below V8's external-memory soft
+  // limit so they can be reclaimed by Scavenger before incremental marking
+  // starts. Without pointer compression, V8's 32 MB default raises the
+  // Scavenge threshold above that limit and can cause frequent Mark-Compacts
+  // for Buffer-heavy workloads. Upstream V8 later changed external-memory
+  // accounting and removed this flag, so keep the workaround scoped to older
+  // V8 versions. Explicit V8 flags parsed below still override this default.
+  // See https://github.com/nodejs/node/issues/63863.
+  V8::SetFlagsFromString("--scavenger-max-new-space-capacity-mb=8");
+#endif
+
 #if defined(NODE_V8_OPTIONS)
   // Should come before the call to V8::SetFlagsFromCommandLine()
   // so the user can disable a flag --foo at run-time by passing
diff --git a/test/parallel/test-buffer-gc-scavenger-default.js b/test/parallel/test-buffer-gc-scavenger-default.js
new file mode 100644
index 00000000..8e8727c1
--- /dev/null
+++ b/test/parallel/test-buffer-gc-scavenger-default.js
@@ -0,0 +1,31 @@
+'use strict';
+
+const common = require('../common');
+const assert = require('assert');
+const { spawnSync } = require('child_process');
+
+if (process.config.variables.v8_enable_pointer_compression)
+  common.skip('Node default applies only without pointer compression');
+
+if (Number(process.versions.v8.split('.')[0]) >= 14)
+  common.skip('workaround is scoped to V8 versions before 14');
+
+function capacity(flags) {
+  const result = spawnSync(process.execPath, [...flags, '--v8-options'], {
+    encoding: 'utf8',
+    env: { ...process.env, NODE_OPTIONS: '' },
+  });
+  assert.ifError(result.error);
+  assert.strictEqual(result.status, 0, result.stderr);
+  const match = result.stdout.match(
+    /default: --scavenger-max-new-space-capacity-mb=(\d+)/,
+  );
+  assert(match, 'expected scavenger capacity in V8 options');
+  return Number(match[1]);
+}
+
+// Verify the compiled default, not a command-line workaround.
+assert.strictEqual(capacity([]), 8);
+// Operators must retain control of the V8 setting.
+assert.strictEqual(capacity(['--scavenger-max-new-space-capacity-mb=32']), 32);
+assert.strictEqual(capacity(['--scavenger-max-new-space-capacity-mb=4']), 4);
